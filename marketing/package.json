{
  "name": "quantum-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vídeos de anúncio do app Quantum, gerados com Remotion. Projeto ISOLADO — não interfere no app principal.",
  "scripts": {
    "studio": "remotion studio",
    "preview": "remotion studio",
    "render:demo": "remotion render DemoAd out/demo-ad.mp4",
    "render:problema": "remotion render ProblemSolutionAd out/problema-solucao.mp4",
    "render:showcase": "remotion render ProductShowcaseAd out/product-showcase.mp4",
    "render:instalar": "remotion render InstallAndroidAd out/instalar-android.mp4",
    "render:all": "npm run render:demo && npm run render:problema && npm run render:showcase && npm run render:instalar",
    "render:demo:1x1": "remotion render DemoAdSquare out/demo-ad-1x1.mp4",
    "render:problema:1x1": "remotion render ProblemSolutionAdSquare out/problema-solucao-1x1.mp4",
    "render:showcase:1x1": "remotion render ProductShowcaseAdSquare out/product-showcase-1x1.mp4",
    "still:demo": "remotion still DemoAd out/demo-poster.png --frame=90"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/google-fonts": "4.0.507",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.507"
  }
}
